{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "lib": ["ES2022"],
    "outDir": "./dist",
    "rootDir": "./src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true
  },
  "include": ["src/**/*"],
  "exclude": [
    "node_modules",
    "dist",
    "src/utils/test-qa-diagnostics.ts",
    "src/utils/test-pdf-quality.ts",
    "src/utils/test-screenshot-preview.ts",
    "src/utils/test-pdf-pagination-matrix.ts",
    "src/utils/test-e2e-browser.ts"
  ]
}
