# Server Environment Variables
# Copy this file to .env and fill in your values

# Database (port 5433 mapped via docker-compose)
DATABASE_URL="postgresql://resume_user:resume_pass_dev@localhost:5433/resume_builder?schema=public"

# JWT Authentication
JWT_SECRET="your-jwt-secret-change-this-in-production"
JWT_EXPIRES_IN="7d"

# Server
PORT=5001
NODE_ENV=development

# Google Gemini API
GEMINI_API_KEY="your-gemini-api-key-here"

# CORS & PDF Rendering Route Origin
# In development: "http://localhost:5173"
# In production: "https://your-frontend-domain.com"
CLIENT_URL="http://localhost:5173"
