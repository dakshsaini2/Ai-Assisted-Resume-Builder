# Client Environment Variables
# Copy this file to .env and fill in your values

# Backend API Base URL (used by standard client API calls and headless PDF rendering)
# - In local development: http://localhost:5001/api (or /api via Vite proxy)
# - In production (separate frontend/backend hosts): https://api.yourdomain.com/api
# - In production (unified host behind reverse proxy): /api
VITE_API_URL=http://localhost:5001/api
